{
  "name": "@recruitflow/worker",
  "version": "1.0.0",
  "private": true,
  "description": "RecruitFlow Background Worker (BullMQ + Redis for AI Resume Parsing, Candidate Matching & Email Dispatch)",
  "scripts": {
    "dev": "node init && tsx watch src/worker.ts",
    "build": "node init && tsc -p tsconfig.json",
    "start": "node init && node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@recruitflow/shared": "*",
    "@recruitflow/types": "*",
    "@recruitflow/validation": "*",
    "bullmq": "^5.40.1",
    "ioredis": "^5.5.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
