# ============================================================================
# RECRUITFLOW — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and configure values for your environment.
# Never commit your actual .env file to version control.
# ============================================================================

# ----------------------------------------------------------------------------
# 1. APPLICATION & PORTS
# ----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PORT=4000
API_PREFIX=api/v1
APP_NAME="RecruitFlow"
NEXT_PUBLIC_APP_NAME="RecruitFlow"

WEB_URL=http://localhost:3000
API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------------------------------
# 2. DATABASE (PostgreSQL + Prisma)
# ----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/recruitflow?schema=public"

# ----------------------------------------------------------------------------
# 3. AUTHENTICATION (Better Auth — Single Source of Truth)
# Generate a strong 32+ character secret: openssl rand -base64 32
# ----------------------------------------------------------------------------
BETTER_AUTH_SECRET="replace-with-a-secure-32-char-minimum-secret-key-2026"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:4000

# Optional OAuth Providers (leave blank to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# 4. REDIS & BACKGROUND WORKER (BullMQ)
# ----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY=5

# ----------------------------------------------------------------------------
# 5. AI PROVIDERS (Provider-Independent Architecture)
# Leave blank to run in unconfigured/disabled AI state or configure via Super Admin UI
# Supported values for DEFAULT_AI_PROVIDER: OPENAI | GEMINI | ANTHROPIC
# ----------------------------------------------------------------------------
DEFAULT_AI_PROVIDER=OPENAI
AI_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef"

OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-latest

# ----------------------------------------------------------------------------
# 6. FILE STORAGE (LOCAL or S3)
# Supported STORAGE_PROVIDER / STORAGE_DRIVER: local | s3
# ----------------------------------------------------------------------------
STORAGE_PROVIDER=local
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/uploads
MAX_RESUME_FILE_SIZE_MB=10

STORAGE_BUCKET=recruitflow-uploads
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=recruitflow-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# ----------------------------------------------------------------------------
# 7. PAYMENTS & SUBSCRIPTIONS (Stripe — Optional for Self-Hosted Mode)
# If STRIPE_SECRET_KEY is empty, RecruitFlow runs in Self-Hosted Licensing Mode.
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# 8. EMAIL / SMTP NOTIFICATIONS
# ----------------------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="RecruitFlow <no-reply@recruitflow.local>"
SMTP_FROM_EMAIL="RecruitFlow <no-reply@recruitflow.local>"
